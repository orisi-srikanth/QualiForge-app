PROJECT_NAME="QualityMind"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True

DATABASE_URL="sqlite:///./backend/data/quality_system.db"

JWT_SECRET="your-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,https://qualiforge-app.vercel.app"
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,https://qualiforge-app.vercel.app"

LLM_PROVIDER="none"

GROQ_API_KEY=""
