# QualityMind Environment Configuration
PROJECT_NAME="QualityMind"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL supported, SQLite fallback for local development)
DATABASE_URL="sqlite:///./backend/data/quality_system.db"

# Security & Authentication
JWT_SECRET="your-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,https://qualiforge-app.vercel.app"
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000,https://qualiforge-app.vercel.app"

# Multi-Provider LLM Configuration (none | groq | openrouter | gemini | openai)
# Set to 'none' for 100% offline rule-based deterministic execution
LLM_PROVIDER="none"

# Shared Provider Keys & Endpoints (OpenAI-compatible)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Optional paid OpenAI key (OpenAI is NOT free; requires paid credits)
# Leave blank to use 100% FREE providers (Groq, OpenRouter, Gemini)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# ==============================================================================
# PER-AGENT MODEL ROUTING & REASONING CONFIGURATION
# (Uses standard OpenAI-compatible client connecting to FREE Groq, OpenRouter, Gemini)
# ==============================================================================

# Agent 1 (Data Intake): Groq openai/gpt-oss-20b, JSON output, reasoning_effort=low
AGENT1_MODEL="openai/gpt-oss-20b"
AGENT1_FALLBACK_MODEL="openai/gpt-oss-20b"
AGENT1_BASE_URL="https://api.groq.com"
AGENT1_API_KEY=""

# Agent 6 (RCA - Req 10): Kilo Gateway + NVIDIA Nemotron
AGENT6_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT6_FALLBACK_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT6_THINKING="high"
AGENT6_BASE_URL="https://api.kilo.ai/api/gateway"
AGENT6_API_KEY=""

# Kilo Gateway Provider
KILO_API_KEY=""
KILO_BASE_URL="https://api.kilo.ai/api/gateway"
KILO_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Agent 7 (CAPA - Req 13): Fast structured JSON
# Free Llama on Groq: "llama-3.3-70b-versatile" or "llama-3.1-8b-instant"
AGENT7_MODEL="llama-3.1-8b-instant"
AGENT7_FALLBACK_MODEL="llama-3.3-70b-versatile"
AGENT7_BASE_URL=""
AGENT7_API_KEY=""

# Agent 8 (Critic): Adversarial review auditing math & causal claims
# Free Llama 3.3 70B on Groq: ultra-fast, independent from Agent 6
AGENT8_MODEL="llama-3.3-70b-versatile"
AGENT8_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct:free"
AGENT8_REASONING_EFFORT="medium"
AGENT8_BASE_URL=""
AGENT8_API_KEY=""

# Report Text Narrative (Req 18): Fast report prose
REPORT_MODEL="llama-3.1-8b-instant"
REPORT_FALLBACK_MODEL="llama-3.3-70b-versatile"
REPORT_BASE_URL=""
REPORT_API_KEY=""

# Hosted Embeddings for RAG (Req 11) - Render Free Tier <512 MB RAM
# Uses hosted Gemini / OpenAI embeddings over HTTP so local memory stays <50 MB
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""

# Computer Vision & Anomaly Models
MVTEC_ROOT=""
CV_MODEL_PATH="./backend/models/cv_model.onnx"
YOLO_MODEL_PATH="./backend/models/yolo_model.onnx"
ANOMALY_MODEL_PATH="./backend/models/anomaly.joblib"

# Storage & Uploads
CHROMA_PATH="./backend/data/chroma_db"
UPLOAD_DIR="./backend/data/uploads"
REPORTS_DIR="./backend/data/reports"

# Frontend Configuration
VITE_API_URL="http://localhost:8000/api"
